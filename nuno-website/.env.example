# Copia este archivo como .env.local y completa los valores.

# URL pública del sitio (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.tudominio.com

# WhatsApp: número en formato internacional, solo dígitos (ej. Colombia: 573001234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Correo público de contacto
NEXT_PUBLIC_CONTACT_EMAIL=

# Redes sociales (déjalas vacías para ocultarlas)
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GITHUB_URL=

# Envío real del formulario (Resend: https://resend.com). Solo servidor, nunca con NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=NUNO <onboarding@resend.dev>
